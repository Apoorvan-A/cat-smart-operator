# Copy to .env and adjust. Never commit real secrets.

# --- Database ---
POSTGRES_USER=cat
POSTGRES_PASSWORD=cat_dev_password
POSTGRES_DB=cat_operator
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://cat:cat_dev_password@db:5432/cat_operator

# --- Auth ---
JWT_SECRET=change-me-in-real-deployments
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Backend ---
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# --- ML service ---
ML_SERVICE_URL=http://ml:9000
ML_MODEL_DIR=/app/models

# --- AI Assistant (LLM explanation layer only; never given DB access) ---
# Leave blank to use the deterministic template-based explainer fallback.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/ws
