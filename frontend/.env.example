# Frontend environment. Copy to `.env.local` to override.

# Backend REST + WebSocket (used when VITE_USE_MOCK=false).
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/ws

# Run the UI against a deterministic in-browser mock of the API_CONTRACT.
# `true`  → self-contained demo (no backend needed) — DEFAULT.
# `false` → hit the real FastAPI backend above.
VITE_USE_MOCK=true
