# Normalize line endings so Windows/macOS/Linux teammates don't get spurious diffs.
* text=auto eol=lf

# Scripts that must stay LF
*.sh   text eol=lf
*.py   text eol=lf

# Windows-only scripts stay CRLF
*.bat  text eol=crlf
*.ps1  text eol=crlf

# Binary assets — never touch
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.pkl  binary
*.joblib binary
*.parquet binary
