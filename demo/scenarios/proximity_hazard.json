{
  "id": "proximity_hazard",
  "title": "Proximity hazard",
  "description": "A worker enters the machine's danger zone (3.2 m, threshold 5 m). Deterministic rule raises a HIGH alert shown on the work-zone map; operator acknowledges.",
  "machine_id": "EXC001",
  "operator_id": "OP1001",
  "steps": [
