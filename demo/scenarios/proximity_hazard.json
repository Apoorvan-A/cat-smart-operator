    { "t_seconds": 12, "inject_proximity": { "entity_type": "WORKER", "entity_id": "W103", "distance_m": 3.2, "threshold_m": 5.0 },
      "expect": { "safety_event": "PROXIMITY_HAZARD", "severity": "HIGH" } },
    { "t_seconds": 18, "operator_action": "acknowledge",
      "expect": { "alert_status": "ACKNOWLEDGED", "audit_record": true } }
  ],
